# Supabase project settings — Project Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed if you add server-side admin operations (e.g. bulk-inviting users)
# Keep this secret — never expose it in client code or NEXT_PUBLIC_ vars.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
